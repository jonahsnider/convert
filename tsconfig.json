{
	"compilerOptions": {
		"checkJs": false,
		"inlineSourceMap": true,
		"inlineSources": true,
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"outDir": "dist",
		"rootDir": ".",
		"rewriteRelativeImportExtensions": true,
		"resolveJsonModule": true,
		"target": "ES2020",
		"types": ["node"]
	},
	"extends": ["@tsconfig/strictest", "@tsconfig/recommended"],
	"include": ["src", "scripts", "test"]
}
